# AASRA — clean URLs. Requires Apache mod_rewrite (enabled by default in XAMPP).
Options -Indexes -MultiViews
DirectoryIndex index.php
DirectorySlash Off

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Never serve source/config/data folders; the router answers with the 404 page.
  RewriteRule ^(config|includes|pages|database)(/|$) index.php [L]

  # Old standalone files in /admin, /provider and /user (e.g. /admin/users.php) are not entry points any more:
  # send them to the router, which redirects to the protected clean URL or answers 404.
  RewriteRule ^(admin|provider|user)/.+\.php$ index.php [L]

  # The application uses /admin as a clean route even though
  # a legacy physical admin directory exists.
  RewriteRule ^admin/?$ index.php [L]

  # Serve real files (assets, uploaded images) directly.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Everything else goes through the front controller.
  RewriteRule ^ index.php [L]
</IfModule>
